# ============================================================
# Starvia — Environment Variables
# Copy to .env.local for local development.
# Add the same keys in Vercel → Project → Settings → Environment Variables.
# ============================================================

# ---- Public (safe for browser) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Server only (NEVER expose to the browser) ----
# Supabase service role key. Bypasses RLS — server use only.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash

# ---- Razorpay (optional until you go live) ----
# Leave RAZORPAY_KEY_ID empty to run in clearly-labelled mock/dev payment mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Mock payments let a checkout activate a plan without money moving. They are
# enabled automatically outside production. In production they are refused unless
# this is explicitly set to "true" — leave it unset in production.
ALLOW_MOCK_PAYMENTS=

# ---- Admin ----
# Comma separated list of emails that can access /admin
ADMIN_EMAILS=

# ---- Rate limiting ----
# Optional Upstash Redis for distributed rate limiting.
# If unset, an in-memory limiter is used (fine for single instance / dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
